<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Portal Auth API Proxy" stopProcessing="true">
          <match url="^api/auth/(.*)" />
          <action type="Rewrite" url="http://localhost:5001/api/auth/{R:1}" />
        </rule>
        <rule name="Dashboard Legacy Render Proxy" stopProcessing="true">
          <match url="^api/dashboard/render/(.*)" />
          <action type="Rewrite" url="http://localhost:8087/render/{R:1}" />
        </rule>
        <rule name="Dashboard Legacy Direct Render Proxy" stopProcessing="true">
          <match url="^api/render/(.*)" />
          <action type="Rewrite" url="http://localhost:8087/render/{R:1}" />
        </rule>
        <rule name="Dashboard API Proxy" stopProcessing="true">
          <match url="^api/dashboard/(.*)" />
          <action type="Rewrite" url="http://localhost:8087/api/{R:1}" />
        </rule>
        <rule name="CodeAnalysis Direct API Proxy" stopProcessing="true">
          <match url="^api/(analyse|portfolio|jobs|reports|health|modules|ai)(.*)" />
          <action type="Rewrite" url="http://localhost:8082/api/{R:1}{R:2}" />
        </rule>
        <rule name="CodeAnalysis API Proxy" stopProcessing="true">
          <match url="^api/codeanalysis/(.*)" />
          <action type="Rewrite" url="http://localhost:8082/api/{R:1}" />
        </rule>
        <rule name="Novastra-ITSM API Proxy" stopProcessing="true">
          <match url="^api/novastra-itsm/(.*)" />
          <action type="Rewrite" url="http://localhost:8086/api/{R:1}" />
        </rule>
        <rule name="Dashboard Render Proxy" stopProcessing="true">
          <match url="^render/(.*)" />
          <action type="Rewrite" url="http://localhost:8087/render/{R:1}" />
        </rule>
        <rule name="Dashboard Metrics Proxy" stopProcessing="true">
          <match url="^metrics/(.*)" />
          <action type="Rewrite" url="http://localhost:8087/metrics/{R:1}" />
        </rule>
        <rule name="InfraRationalization API Proxy" stopProcessing="true">
          <match url="^api/infra/(.*)" />
          <action type="Rewrite" url="http://localhost:8083/api/{R:1}" />
        </rule>
        <rule name="Modernization API Proxy" stopProcessing="true">
          <match url="^api/mod/(.*)" />
          <action type="Rewrite" url="http://localhost:8084/api/{R:1}" />
        </rule>
        <rule name="LabRobot API Proxy" stopProcessing="true">
          <match url="^api/lab/(.*)" />
          <action type="Rewrite" url="http://localhost:8000/api/{R:1}" />
        </rule>
        <rule name="LabRobot MQTT WebSocket Proxy" stopProcessing="true">
          <!-- The Azure Relay Hybrid Connection backing strat-iq.azurewebsites.net
               only tunnels to localhost:8090 (this site) — no other port is
               reachable from the public site, and an HTTPS page cannot open a
               plain ws:// socket anyway (mixed content). So the browser talks
               wss://.../api/lab-mqtt/... on this same origin/port, and IIS
               (WebSocket Protocol feature enabled below) proxies the upgraded
               connection through to the local Aedes broker's ws listener. -->
          <match url="^api/lab-mqtt/(.*)" />
          <action type="Rewrite" url="http://localhost:9001/{R:1}" />
        </rule>
        <rule name="SSDLC CSM API Proxy" stopProcessing="true">
          <match url="^api/csm/(.*)" />
          <action type="Rewrite" url="http://localhost:8091/api/csm/{R:1}" />
        </rule>
        <rule name="SSDLC Assessment API Proxy" stopProcessing="true">
          <match url="^api/ssdlc/(.*)" />
          <action type="Rewrite" url="http://localhost:8091/api/{R:1}" />
        </rule>
        <rule name="OpportunityTracker API Proxy" stopProcessing="true">
          <match url="^api/ot/(.*)" />
          <action type="Rewrite" url="http://localhost:8092/api/{R:1}" />
        </rule>
        <rule name="AI Reman Core API Proxy" stopProcessing="true">
          <match url="^api/reman/(.*)" />
          <action type="Rewrite" url="http://localhost:8093/api/{R:1}" />
        </rule>
        <rule name="AI Vehicle Loan API Proxy" stopProcessing="true">
          <match url="^api/vehicle-loan/(.*)" />
          <action type="Rewrite" url="http://localhost:8094/api/{R:1}" />
        </rule>
        <rule name="TraceForge API Proxy" stopProcessing="true">
          <match url="^api/tf/(.*)" />
          <action type="Rewrite" url="http://localhost:8095/api/{R:1}" />
        </rule>
        <rule name="SCM KG Service API Proxy" stopProcessing="true">
          <match url="^api/kg/(.*)" />
          <action type="Rewrite" url="http://localhost:8001/{R:1}" />
        </rule>
        <rule name="SCM Signal Inspector API Proxy" stopProcessing="true">
          <match url="^api/inspector/(.*)" />
          <action type="Rewrite" url="http://localhost:8003/{R:1}" />
        </rule>
        <rule name="SCM Agent Service API Proxy" stopProcessing="true">
          <match url="^api/agents/(.*)" />
          <action type="Rewrite" url="http://localhost:8002/{R:1}" />
        </rule>
        <rule name="Portal API Proxy" stopProcessing="true">
          <!-- Catch-all fallback for AppRationalization (port 5001) — every other
               module above has its own distinctly-prefixed rule (api/novastra-itsm/, api/mod/,
               api/ot/, etc.) and is matched first via stopProcessing="true", so this
               only ever catches what's left over: any api/* path that belongs to
               AppRationalization's own Flask backend. Previously this rule used a
               hardcoded literal whitelist (upload|analysis|dashboard|correlation|...)
               that had to be manually updated every time a new AppRationalization
               route was added — it was NOT kept in sync (golden-data and
               standardization-analysis both 404'd for this exact reason) and would
               keep silently breaking new routes indefinitely. A broad fallback in
               this position is permanent: it requires no maintenance as backend
               routes are added, and cannot regress the other modules' routing since
               they all match earlier, more specific rules first. -->
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:5001/api/{R:1}" />
        </rule>
        <rule name="Static Files" stopProcessing="true">
          <match url=".*\.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2)$" />
          <action type="None" />
        </rule>
        <rule name="Portal SPA Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- The SPA shell contains content-hashed JS/CSS filenames. It must always be
       revalidated so a browser cannot keep an old shell after a deployment and
       then request bundles that no longer exist. Hashed assets remain cacheable. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-store, no-cache, must-revalidate" />
          <add name="Pragma" value="no-cache" />
          <add name="Expires" value="0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- Modernization's "upload from my computer" folder intake (see
       api/server.py POST /api/fs/upload-folder) can legitimately post a
       source-tree's worth of files at once; IIS's default request-body cap
       is ~28.6 MB, well under what a real project needs. Raised to 200 MB
       here to match _UPLOAD_MAX_BYTES in the backend exactly. Scoped to
       this one route rather than site-wide, since no other module accepts
       bulk file uploads. -->
  <location path="api/mod">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="209715200" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
