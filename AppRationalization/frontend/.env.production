# Production environment - used by npm run build
# IIS web.config proxies /api/auth/* (and others) to the backend, so use same-origin /api.
# api.js also has a runtime fallback: absolute localhost:5000 only when window.location.hostname
# is literally "localhost"/"127.0.0.1", otherwise relative "/api" — leave REACT_APP_API_URL unset
# here so that logic applies for every other hostname (including strat-iq.azurewebsites.net).
REACT_APP_ENVIRONMENT=production
REACT_APP_APP_RATIONALIZATION_URL=/app-rationalization
REACT_APP_CODE_ANALYSIS_URL=/ca/
REACT_APP_INFRA_SCAN_URL=/infra/
REACT_APP_DASHBOARD_URL=/dash/
REACT_APP_NOVASTRA_ITSM_URL=/novastra-itsm/ticket-analysis
REACT_APP_MODERNIZATION_URL=/mod/
REACT_APP_LAB_ROBOT_URL=/lab/
REACT_APP_OPPORTUNITY_TRACKER_URL=/ot/
REACT_APP_SSDLC_PROCESS_ASSESSMENT_URL=/ssdlc/
REACT_APP_AI_REMAN_CORE_URL=/reman/
REACT_APP_AI_VEHICLE_LOAN_URL=/vl/
REACT_APP_MICROSITE_DATA_ANALYSIS_URL=/mda/
REACT_APP_SUPPLY_CHAIN_DISRUPTION_MANAGER_URL=/scm/
REACT_APP_TRACEFORGE_URL=/tf/
